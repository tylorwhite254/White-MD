# Server
PORT=3000
HOST=0.0.0.0

# WhatsApp pairing. Use international format without +, spaces, or dashes.
# Example: 254700000000
PAIRING_NUMBER=
# Leave blank to choose 1 (QR) or 2 (phone pairing) at panel startup.
# Set LOGIN_METHOD=qr or LOGIN_METHOD=pair to skip the prompt.
LOGIN_METHOD=

# Optional display/configuration values
BOT_NAME=White MD
COMMAND_PREFIX=.
MENU_IMAGE_URL=https://files.catbox.moe/ift8n5.jpeg
# Optional: automatically follow this channel from the linked White MD account on connection.
# This does not force other WhatsApp users to follow the channel.
AUTO_FOLLOW_CHANNEL_JID=120363401194818136@newsletter
# Optional clickable channel URL shown below the .menu output.
AUTO_FOLLOW_CHANNEL_URL=https://whatsapp.com/channel/0029VbAvp6OCXC3LkXKNmM3X
# Optional: on a person's first private message, send a notice and attempt group enrollment.
# The bot must be a group admin and WhatsApp privacy settings may reject the add.
# Invite link of your group. Every WhatsApp account linked to this bot joins it automatically.
AUTO_JOIN_GROUP_INVITE=
AUTO_ENROLL_GROUP_JID=
AUTO_ENROLL_NOTICE=Welcome to White MD. You are being invited to join our WhatsApp group and follow our channel.
# Verified DavidCyril routes work without a key; keep your own backups after them.
AI_PROVIDERS=david-gpt4o,david-gemini3pro,openrouter,xai
AI_TIMEOUT_MS=15000
# .chatgpt/.chatbot primary and backup order. These providers need their own credentials below.
CHATGPT_PRIMARY_PROVIDER=david-chatbot
CHATGPT_BACKUP_PROVIDERS=david-gpt4o,david-gemini3pro,openrouter,xai
# Verified official DavidCyril utility endpoints. Leave the key blank for the tested public routes;
# add your own key if the provider later requires authentication.
DAVID_CYRIL_API_KEY=
DAVID_CYRIL_API_URL=https://apis.davidcyril.name.ng
# WaveSpeedAI FLUX 3 image generation; obtain your own key from https://wavespeed.ai/accesskey.
WAVESPEED_API_KEY=
WAVESPEED_API_BASE=https://api.wavespeed.ai/api/v3
WAVESPEED_FLUX_IMAGE_MODEL=black-forest-labs/flux-3/text-to-image
WAVESPEED_POLL_LIMIT=45
WAVESPEED_POLL_MS=2000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# xAI/Grok: https://console.x.ai/team/default/api-keys
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_API_URL=https://api.x.ai/v1/chat/completions
# Optional Brainshop credentials. Never commit real keys to the repository.
BRAINSHOP_BID=
BRAINSHOP_KEY=
BRAINSHOP_UID=white-md-user
# Optional OMDb metadata key for .movie/.film. Do not commit the real key.
OMDB_API_KEY=
# Optional PikaBotz credential. Never commit the real key to the repository.
PIKABOTZ_API_KEY=
PLAY_DOWNLOAD_URL=https://api.davidcyriltech.my.id/download/ytmp3
# YouTube fallback provider used by .play, .song, .ytmp3, .ytmp4, and Spotify fallback.
# Set your own permitted provider key when available; the built-in public key may be revoked.
YT_SAVE_BASE=https://p.savenow.to
YT_SAVE_KEY=
YT_SAVE_POLLS=30
YT_SAVE_POLL_MS=2000
MEGA_PLAY_API_URL=https://api.qasimdev.dpdns.org/api/loaderto/download
MEGA_PLAY_API_KEY=
# Owner number in international format, without +, spaces, or dashes.
OWNER_NUMBER=
# Owner-only Git update settings. The deployment must be a Git checkout for .update.
UPDATE_REPO_URL=https://github.com/tylorwhite254/White-MD.git
UPDATE_BRANCH=main
UPDATE_INSTALL_DEPS=true

# Local Baileys credentials directory. Persist this directory in production.
AUTH_DIR=auth_info
SETTINGS_FILE=bot_settings.json

# Set LOG_LEVEL=debug for troubleshooting. The default warn level hides routine startup/plugin logs.
# Set LOG_WHATSAPP_MESSAGES=false to hide message text from server logs.
LOG_LEVEL=warn
LOG_WHATSAPP_MESSAGES=true

# YouTube MP4 plugin
KNIGHT_API_KEY=
KNIGHT_API_ROOT=https://knightbotapi.stream/api
# Optional compatible API root used when the primary provider returns HTTP 429.
KNIGHT_API_FALLBACK_ROOT=
KNIGHT_API_FALLBACK_KEY=
KNIGHT_API_BASE=https://knightbotapi.stream/api/download/ytmp4
KNIGHT_DOWNLOAD_API_BASE=https://knightbotapi.stream/api/download
KNIGHT_SPOTIFY_API_BASE=https://knightbotapi.stream/api/spotify
KNIGHT_TIKTOK_API_BASE=https://knightbotapi.stream/api/download/tiktok
MAX_DOWNLOAD_DURATION=900
MAX_MEDIA_BYTES=52428800
API_TIMEOUT_MS=20000
API_RETRIES=2
API_MAX_RETRY_DELAY_MS=15000
TTS_LANG=en
CARD_PIC=
CARD_THEME=dark
CARD_COUNT=128
CARD_AUTHOR=Tylor White

# WhatsApp buttons and pick-lists. Set to off to always send plain text replies.
BUTTONS=on

# --- Downloader provider (.url <link>, .apk <link>) ---
# Key from your downloader provider (api.downloader.org style). Required for link downloads.
DOWNLOADER_API_KEY=
# DOWNLOADER_API_URL=https://api.downloader.org/api/v1/submit/
# Leave empty to send the header exactly as "Authorization: <key>". Set to Bearer/Token if your provider needs it.
# DOWNLOADER_AUTH_SCHEME=

# --- Optional ---
# CATBOX_USERHASH=            # lets .url upload to your Catbox account (other hosts are tried automatically)
# MAX_APK_BYTES=157286400     # biggest APK sent as a file (default 150 MB)
# MAX_MOVIE_BYTES=314572800   # biggest archive.org film sent as a file (default 300 MB)
# MOVIES_API_URL=https://movies-api.accel.li/api/v2/
# CONSOLE_CHAT_STYLE=plain    # flat console lines instead of the coloured chat bubbles

# --- Text to speech (.tts, .tts1-.tts6, .villain, .hero ...) ---
# TTS_VOICE=en-US-ChristopherNeural   # default voice for everyone
# TTS_VOICE_NOTE=off                  # send audio files instead of voice notes

# --- Persistent Data & Restart Survival ---
# Single directory for auth_info, bot_settings.json, group_settings.json, notes, AFK, reminders, warnings, TTS.
# Mount a persistent disk here on Render/Pterodactyl/Docker (e.g. /data).
DATA_DIR=./data

# Optional portable session string (from .sessionid or the Web Pairing page).
# Automatically restores your WhatsApp session and settings on ephemeral hosts after a restart!
SESSION_ID=

# Optional remote JSON backup endpoint (GET restores, POST saves { sessionId })
SESSION_SYNC_URL=
SESSION_SYNC_TOKEN=

# --- Web Pairing Portal ---
# Set to true to skip the terminal prompt and pair directly from the webpage (http://HOST:PORT)
WEB_PAIRING=true
# Optional password required to request pairing codes or export SESSION_ID from the webpage
WEB_PAIR_SECRET=
# Allowed browser origin for an external pairing webpage (use * or your Lovable app URL)
CORS_ORIGIN=*

# Default menu style: number (works in all DMs), list, or buttons
MENU_STYLE=number
# Bot mode: public (works in all DMs & groups) or private (owner/sudo only)
MODE=public
